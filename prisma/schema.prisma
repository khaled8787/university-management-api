generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  DROPPED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentType {
  TUITION_FEE
  COURSE_FEE
  SEMESTER_FEE
  OTHER
}

enum PaymentMethod {
  STRIPE
  BKASH
  SSLCOMMERZ
}

enum Grade {
  A_PLUS
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  D
  F
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ROLE_CHANGE
  STATUS_CHANGE
  PAYMENT
  ENROLLMENT
}

// ============================================================
// USER
// ============================================================

model User {
  id       String     @id @default(cuid())
  email    String     @unique
  password String?
  name     String
  role     UserRole   @default(STUDENT)
  status   UserStatus @default(ACTIVE)

  googleId     String? @unique
  profileImage String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
  faculty Faculty?

  auditLogs AuditLog[] @relation("AuditActor")

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

// ============================================================
// DEPARTMENT
// ============================================================

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  faculties Faculty[]
  courses   Course[]

  @@index([name])
  @@index([code])
  @@index([deletedAt])
}

// ============================================================
// STUDENT
// ============================================================

model Student {
  id        String @id @default(cuid())
  studentId String @unique

  userId       String @unique
  departmentId String

  semester    Int       @default(1)
  batch       String
  phone       String?
  dateOfBirth DateTime?
  address     String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  enrollments Enrollment[]
  attendances Attendance[]
  results     Result[]
  payments    Payment[]

  @@index([departmentId])
  @@index([batch])
  @@index([semester])
  @@index([deletedAt])
}

// ============================================================
// FACULTY
// ============================================================

model Faculty {
  id         String @id @default(cuid())
  employeeId String @unique

  userId       String @unique
  departmentId String

  designation    String
  phone         String?
  specialization String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  courses     Course[]     @relation("CourseFaculty")
  attendances Attendance[]
  results     Result[]

  @@index([departmentId])
  @@index([designation])
  @@index([deletedAt])
}

// ============================================================
// COURSE
// ============================================================

model Course {
  id String @id @default(cuid())

  code        String  @unique
  title       String
  description String?
  credit      Float

  departmentId String
  facultyId    String?

  semester Int
  capacity Int @default(30)

  isActive Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  faculty    Faculty?   @relation("CourseFaculty", fields: [facultyId], references: [id], onDelete: SetNull)

  enrollments Enrollment[]
  attendances Attendance[]
  results     Result[]

  @@index([departmentId])
  @@index([facultyId])
  @@index([semester])
  @@index([isActive])
  @@index([deletedAt])
  @@index([title])
}

// ============================================================
// ENROLLMENT
// ============================================================

model Enrollment {
  id String @id @default(cuid())

  studentId String
  courseId  String

  status EnrollmentStatus @default(PENDING)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([deletedAt])
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id String @id @default(cuid())

  studentId String
  courseId  String
  facultyId String

  date   DateTime
  status AttendanceStatus

  remarks String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
  @@index([facultyId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
}

// ============================================================
// RESULT
// ============================================================

model Result {
  id String @id @default(cuid())

  studentId String
  courseId  String
  facultyId String

  marks      Float
  grade      Grade
  gradePoint Float

  remarks String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([facultyId])
  @@index([grade])
  @@index([deletedAt])
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id String @id @default(cuid())

  studentId String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("BDT")

  type   PaymentType
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  transactionId     String? @unique
  providerSessionId String? @unique

  paidAt        DateTime?
  failureReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  actorId String?
  action  AuditAction

  entity   String
  entityId String?

  description String?
  oldData     Json?
  newData     Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}